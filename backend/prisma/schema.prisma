// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organizador {
  id            Int      @id @default(autoincrement())
  nome          String
  email         String   @unique
  senha         String
  dataCadastro  DateTime @default(now())
  jogadores     Jogador[]

  peladas   Pelada[]
}

model Jogador {
  id              Int      @id @default(autoincrement())
  nome            String
  nivel_estrelas  Float    @default(3.0)
  ativo           Boolean  @default(true)
  dataCadastro    DateTime @default(now())

  organizadorId   Int
  organizador     Organizador @relation(fields: [organizadorId], references: [id])
  peladas   PeladaJogador[]
}

model Pelada {
  id                    Int       @id @default(autoincrement())
  titulo                String?
  data_hora             DateTime
  local                 String
  duracao_minutos       Int
  jogadores_por_time    Int
  times_simultaneos     Int
  valor_por_jogador     Float?
  status                String    @default("agendada")

  organizador_id        Int
  organizador           Organizador @relation(fields: [organizador_id], references: [id])

  jogadores             PeladaJogador[]

  createdAt             DateTime @default(now())
}

model PeladaJogador {
  id                    Int     @id @default(autoincrement())

  pelada_id             Int
  jogador_id            Int

  ordem_chegada         Int
  presenca_confirmada   Boolean @default(false)
  pagamento_confirmado  Boolean @default(false)

  pelada                Pelada  @relation(fields: [pelada_id], references: [id])
  jogador               Jogador @relation(fields: [jogador_id], references: [id])

  @@unique([pelada_id, jogador_id]) // evita duplicado
}